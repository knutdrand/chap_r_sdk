# Generated by chap.r.sdk::generate_dockerfile()
# This Dockerfile creates a container with R, renv packages, Python, and chapkit

# Stage 1: R environment with packages
FROM rocker/r-ver:4.5.2 AS r-env

WORKDIR /model

# No system dependencies detected

# Copy renv files first for layer caching
COPY renv.lock renv.lock
COPY .Rprofile .Rprofile
COPY renv/activate.R renv/activate.R

# Install renv and restore packages
RUN R -e "install.packages('renv', repos='https://cloud.r-project.org')" \
    && R -e "renv::restore()"

# Stage 2: Add Python + chapkit
FROM r-env AS runtime

# Install Python
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Create and activate virtual environment
ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Install chapkit
RUN pip install --no-cache-dir chapkit

# Copy model code
COPY . .

# Expose default port
EXPOSE 8000

# Run the service
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]

