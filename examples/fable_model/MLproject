name: fable_model
renv_env: renv.lock
user_options:
  n_samples:
    type: integer
    description: Number of Monte Carlo samples to generate per forecast
    default: 100.0
  seasonal_period:
    type: integer
    description: Seasonal period for the ETS model (12 for monthly data)
    default: 12.0
  use_covariates:
    type: boolean
    description: Whether to use climate covariates (rainfall, temperature) as regressors
    default: no
  covariate_lag:
    type: integer
    description: Lag in months for climate covariates
    default: 1.0
entry_points:
  train:
    parameters:
      train_data: str
      model: str
    command: Rscript model.R train --data {train_data} --model {model}
  predict:
    parameters:
      historic_data: str
      future_data: str
      model: str
      out_file: str
    command: Rscript model.R predict --historic {historic_data} --future {future_data}
      --model {model} --output {out_file}
