name: arima_model
renv_env: renv.lock
user_options:
  lag_periods:
    type: integer
    description: Number of periods to lag rainfall and temperature
    default: 3
  n_samples:
    type: integer
    description: Number of Monte Carlo samples to generate per forecast
    default: 100
entry_points:
  train:
    parameters:
      train_data: str
      model: str
      model_config:
        type: str
        default: ''
    command: Rscript model.R train --data {train_data} --model {model} --config
      {model_config}
  predict:
    parameters:
      historic_data: str
      future_data: str
      model: str
      out_file: str
      model_config:
        type: str
        default: ''
    command: Rscript model.R predict --historic {historic_data} --future {future_data}
      --model {model} --output {out_file} --config {model_config}
